rules_version = '2';

// 실증 단계 규칙: 촬영 티켓을 만든 작가만 자기 티켓과 사진 목록을 읽고 쓴다.
// 고객 접근과 티켓 상태 전이 검증은 티켓 모델을 확정한 뒤 추가한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTicketPhotographer(ticketId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/tickets/$(ticketId)).data.photographerUid == request.auth.uid;
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn() && resource.data.photographerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.photographerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.photographerUid == request.auth.uid
        && request.resource.data.photographerUid == resource.data.photographerUid;
      allow delete: if false;

      // 찜(favoritedAt)과 구매(purchasedAt)는 고객과 결제 서버가 쓴다. 작가 앱은 읽기만 하고 고칠 수 없다.
      // 실증 단계에서는 관리자 스크립트(firebase/scripts/simulate_demand_dev.py)만 쓴다.
      match /photos/{photoId} {
        allow read: if isTicketPhotographer(ticketId);
        allow create: if isTicketPhotographer(ticketId)
          && !request.resource.data.keys().hasAny(['favoritedAt', 'purchasedAt']);
        allow update: if isTicketPhotographer(ticketId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['favoritedAt', 'purchasedAt']);
        allow delete: if false;
      }
    }

    // 작가 기기의 푸시 토큰. 고객이 사진을 사면 서버 함수(firebase/functions)가 이 토큰으로 작가 앱을 깨운다.
    // 작가 본인만 읽고 쓰며, 토큰과 갱신 시각 말고는 쓰지 못한다.
    match /photographers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fcmToken', 'fcmTokenUpdatedAt'])
        && request.resource.data.fcmToken is string
        && request.resource.data.fcmToken.size() < 4096;
      allow delete: if false;
    }
  }
}
